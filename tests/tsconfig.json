{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    "module": "ESNext",
    "moduleResolution": "node",
    "types": ["node"]
  },
  "include": [
    "core/**/*.ts",
    "core/**/*.d.ts"
  ],
  "exclude": [
    "**/node_modules",
    "ui",
    "providers",
    "core/samples/js/advanced"
  ]
}
